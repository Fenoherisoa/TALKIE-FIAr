<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header & App Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_primary"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvAppSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TECH-FIARAM • RFC OFFICE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnChannels"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_talkie_channel"
                    app:tint="@color/teal_primary"
                    android:contentDescription="@string/dialog_channels_title" />

                <ImageButton
                    android:id="@+id/btnParticipants"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_talkie_users"
                    app:tint="@color/teal_primary"
                    android:contentDescription="@string/dialog_participants_title" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_talkie_settings"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="@string/dialog_settings_title" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Status & Station Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider_dark"
            app:cardBackgroundColor="?attr/colorSurfaceVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/ic_talkie_mic"
                        android:backgroundTint="@color/status_red"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvStatusTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/status_disconnected"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvPeerBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 poste(s)"
                        android:textSize="11sp"
                        android:textColor="@color/teal_primary"
                        android:textStyle="bold"
                        android:background="@drawable/ic_launcher_background"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatusSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_disconnected_sub"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:lineSpacingExtra="2dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_dark"
                    android:layout_marginVertical="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvCurrentChannelInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Canal : TECH-01 (Public)"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/teal_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCurrentUserDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Poste : TECH-USER"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Configuration Inputs -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="@string/label_user"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TECH-USER"
                android:singleLine="true"
                android:maxLength="20" />
        </com.google.android.material.textfield.TextInputLayout>

        <Spinner
            android:id="@+id/spMode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/colorSurfaceVariant"
            android:paddingHorizontal="12dp" />

        <!-- Connection Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="14dp"
            android:text="@string/btn_connect"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/teal_primary"
            android:textColor="@color/dark_background" />

        <!-- VU Meter / Level bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvVuLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MODULATION AUDIO"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvVuPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_primary"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBarAudio"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/teal_primary" />
        </LinearLayout>

        <!-- Push-To-Talk Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPtt"
                android:layout_width="match_parent"
                android:layout_height="124dp"
                android:text="@string/btn_ptt_idle"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                app:cornerRadius="20dp"
                android:backgroundTint="@color/ptt_idle"
                android:textColor="@color/white"
                app:icon="@drawable/ic_talkie_mic"
                app:iconSize="28dp"
                app:iconGravity="textStart"
                android:enabled="false" />
        </RelativeLayout>

        <!-- Hands-free / Lock Toggle Checkbox -->
        <CheckBox
            android:id="@+id/cbLockPtt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mode émission verrouillée (mains libres)"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp" />

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="TALKIE TECH &amp; TECH-FIARAM • RFC OFFICE\nRadiocommunication locale autonome sans Internet"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
